<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INGRESAR: Primer número y Segundo número:"
        android:textColor="#F44336"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/gsja_et_nombres_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombres:"
        android:enabled="false" />

    <EditText
        android:id="@+id/gsja_et_apellidos_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Apellidos:"
        android:enabled="false" />

    <EditText
        android:id="@+id/gsja_et_dividendo_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Primer número:"
        android:inputType="numberSigned"
        android:enabled="true" />

    <EditText
        android:id="@+id/gsja_et_divisor_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Segundo número:"
        android:inputType="numberSigned"
        android:enabled="true" />

    <Button
        android:id="@+id/gsja_btn_cerrar_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#8BC34A"
        android:text="Cerrar" />

</LinearLayout>